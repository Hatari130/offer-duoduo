limit_req_zone $binary_remote_addr zone=offerflow_api:10m rate=20r/s;

server {
  listen 80;
  server_name app.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name app.example.com;

  ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  root /srv/offerflow/apps/web/dist;
  index index.html;

  include /srv/offerflow/deploy/nginx-security-headers.conf;

  location /api/ {
    limit_req zone=offerflow_api burst=40 nodelay;
    proxy_pass http://127.0.0.1:8787/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
