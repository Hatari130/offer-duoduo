{
  "name": "@offerflow/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run typecheck && vite build",
    "build:production": "node scripts/validate-production-env.mjs && pnpm run typecheck && vite build",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@offerflow/api-client": "workspace:*",
    "@offerflow/contracts": "workspace:*",
    "@offerflow/domain": "workspace:*",
    "@offerflow/ui": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
