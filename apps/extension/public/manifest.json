{
  "manifest_version": 3,
  "name": "OfferDuoDuo",
  "description": "从招聘网页抓取岗位，并持续管理求职投递进度。",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 OfferDuoDuo"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["extraction-rules.js", "form-adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "tailor.html", "assets/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
