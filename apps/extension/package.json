{
  "name": "@offerflow/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run typecheck && vite build && pnpm run validate:build",
    "test:capture": "node --test tests/capture-matching.test.mjs tests/deepseek-sanitize.test.mjs && node tests/run-dom-fixture.mjs",
    "test:pdf-fidelity": "node scripts/check-pdf-fidelity.mjs",
    "test:extension-pdf-flow": "node scripts/check-extension-pdf-flow.mjs",
    "test:tailor": "node --experimental-transform-types --test tests/pdf-editable-blocks.test.mjs tests/pdf-backed-html.test.mjs tests/source-pdf-reference.test.mjs tests/tailor-render.test.mts",
    "test:sync": "node --experimental-transform-types --test tests/cloud-sync-outbox.test.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@offerflow/api-client": "workspace:*",
    "@offerflow/contracts": "workspace:*",
    "@offerflow/domain": "workspace:*",
    "@offerflow/ui": "workspace:*",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "simple-icons": "16.21.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
