DATABASE_URL=postgresql://user:password@localhost:5432/offerflow
API_HOST=127.0.0.1
API_PORT=8787
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOW_DEMO_AUTH=true
REGISTRATION_MODE=open
ALLOWED_REGISTRATION_EMAILS=
EMAIL_VERIFICATION_ENABLED=false
EMAIL_CODE_HMAC_SECRET=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
DIRECTMAIL_ACCOUNT=noreply@mail.jobkoi.cn
DIRECTMAIL_FROM_ALIAS=JobKoI
WEB_SESSION_TTL_SECONDS=2592000
DEVICE_SESSION_TTL_SECONDS=7776000
AUTH_COOKIE_NAME=offerflow_session
REQUIRE_HTTPS=false
# Required for the trusted server-side opportunity importer. Never put this in the extension.
OPPORTUNITY_INGEST_KEY=local-development-ingest-key-change-me
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Free, unofficial BcutASR is enabled by default. Set disabled to accept audio
# into a failed record without sending it to a third-party transcription API.
INTERVIEW_ASR_PROVIDER=bcut
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Comma-separated JobKoI account emails allowed to open apps/admin.
ADMIN_EMAILS=owner@example.com
