{
  "name": "offerflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm run dev:extension",
    "dev:extension": "pnpm --filter @offerflow/extension dev",
    "build": "pnpm -r --if-present run build",
    "build:extension": "pnpm --filter @offerflow/extension build",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "~5.6.3"
  }
}
